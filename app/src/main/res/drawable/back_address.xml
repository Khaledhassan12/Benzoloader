<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="@dimen/address_padbottom"
        android:right="@dimen/address_button"
        android:bottom="@dimen/address_padbottom">
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners
                android:radius="@dimen/popup_radius"
                android:topLeftRadius="@dimen/popup_radius"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/popup_radius"
                android:bottomRightRadius="0dp"/>
            <stroke
                android:width="@dimen/divider_width"
                android:color="?attr/myDivider"/>
        </shape>
    </item>
    <item
        android:top="@dimen/address_padbottom"
        android:bottom="@dimen/address_padbottom">
        <shape>
            <corners android:radius="@dimen/popup_radius"/>
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="@dimen/divider_width"
                android:color="?attr/myDivider"/>
        </shape>
    </item>
</layer-list>
