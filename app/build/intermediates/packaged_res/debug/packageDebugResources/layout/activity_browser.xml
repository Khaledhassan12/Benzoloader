<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Browser Navigation Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnBrowserBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/sort_size_down"
                    android:rotation="90"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnBrowserForward"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Forward"
                    android:src="@drawable/sort_size_down"
                    android:rotation="270"
                    app:tint="#FFFFFF" />

                <!-- URL / Search Input -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtBrowserUrl"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/back_dialog"
                    android:hint="@string/browser_search_or_url"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnBrowserRefresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh"
                    android:src="@drawable/stat_start"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnBrowserMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <!-- Page Loading Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBarBrowser"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Floating Media Sniffer Badge -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabMediaSniffer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/browser_download_media"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:backgroundTint="#E53935"
        app:icon="@drawable/ic_download"
        app:iconTint="#FFFFFF"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
